# Megumi WhatsApp Bot Configuration

# Telegram Bot API Token for fetching Telegram sticker packs
# Obtain one from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Optional: Custom Telegram Bot API Base (e.g. proxy, local Bot API server)
# Defaults to https://api.telegram.org
# TELEGRAM_API_BASE=https://api.telegram.org

# Where `!group news` remembers which groups subscribed. Defaults to news.json.
# NEWS_DB=news.json

# Where `!remind` remembers the reminders each chat has set. Defaults to
# reminders.json.
# REMINDER_DB=reminders.json

# Local hour the morning digest goes out at. Defaults to 7.
# NEWS_HOUR=7

# The AI agent. Without a credential the agent still stores every message for
# context, but it never replies. `ANTHROPIC_AUTH_TOKEN` is sent as a Bearer
# token (what Claude Code and most gateways use); `ANTHROPIC_API_KEY` is an
# accepted fallback.
# ANTHROPIC_AUTH_TOKEN=sk-ant-...
# ANTHROPIC_API_KEY=sk-ant-...

# The model the agent calls. Defaults to `claude-sonnet-5-5`.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# The Messages API base URL. May include /v1 or not; /messages is appended
# either way. Point it at a gateway or proxy to route elsewhere. Defaults to
# the real Anthropic host.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Where the agent keeps each chat's history, its memory store, and its turn log.
# Defaults to agent/.
# AGENT_DIR=agent

# Context and reply budgets, and how much history is kept. Defaults are 30 recent
# group messages, 40 private, 6000 context tokens, 1024 reply tokens, 200 stored
# messages per chat, 500 traced turns, and a 6-hour private-session gap.
# AGENT_GROUP_WINDOW=30
# AGENT_PRIVATE_WINDOW=40
# AGENT_MAX_CONTEXT_TOKENS=6000
# AGENT_MAX_REPLY_TOKENS=1024
# AGENT_STORE_WINDOW=200
# AGENT_TRACE_CAPACITY=500
# AGENT_SESSION_GAP=21600

# The `!summary` command's budgets (defaults 512 tokens, 2000 characters) and how
# many facts `!memory` lists (default 20).
# AGENT_SUMMARY_TOKENS=512
# AGENT_SUMMARY_MAX_CHARS=2000
# AGENT_MEMORY_LIST_TOP=20

# Semantic memory. A pass runs when a chat has this many unprocessed messages
# (default 25) or has sat with a backlog this long in seconds (default 600); it
# reads at most 50 messages, may use 1024 tokens, and shows at most 50 existing
# facts for targeting. A turn recalls at most 8 facts into the prompt.
# AGENT_MEMORY_EXTRACT_BATCH=25
# AGENT_MEMORY_EXTRACT_IDLE=600
# AGENT_MEMORY_EXTRACT_MAX_MESSAGES=50
# AGENT_MEMORY_EXTRACT_TOKENS=1024
# AGENT_MEMORY_EXTRACT_MAX_MEMORIES=50
# AGENT_MEMORY_RECALL_TOP=8

# The tool loop. A turn may call tools up to this many times before it must
# answer (default 3; 0 disables tools). Without TAVILY_API_KEY the only tool is
# the memory search, so the bot has no web search.
# AGENT_MAX_TOOL_ITERATIONS=3

# Web search (Tavily). Set the key to give the agent a web_search tool; the base
# is overridable for a proxy. `web_search` asks for 5 results and hands back at
# most 4000 characters of them.
# TAVILY_API_KEY=tvly-...
# TAVILY_API_BASE=https://api.tavily.com
# AGENT_WEB_SEARCH_RESULTS=5
# AGENT_WEB_SEARCH_MAX_CHARS=4000
