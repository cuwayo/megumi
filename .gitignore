# Build output
/target
# The vendored crate is its own workspace, so it gets its own target directory.
/vendor/*/target
/vendor/*/Cargo.lock

# Media the benchmark example downloads, re-fetchable with the example itself.
/bench-data

# The linked WhatsApp account's session. Never commit it.
whatsapp.db*

# Which groups subscribed to the morning digest, and which mornings went out.
news.json*

# Secrets. .env.example is the committed template.
.env
.env.*
!.env.example

# rustfmt and rust-analyzer
**/*.rs.bk
.cargo/config.toml.bak

# Editors and IDEs
.idea/
.vscode/
*.swp
*~

# OS junk
.DS_Store
Thumbs.db
